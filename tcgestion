    tot.w[0]+=y;tot.w[1]+=e;return {t:t.texto+` <span class="chip">${esc((t.dia||'').slice(0,3))}</span>`,raw:1,cells,y,e,p:e?Math.round(y/e*100):null}});
  // mensuales
  const data=S.cal[hMes]||{},mRows=[];
  Object.keys(data).map(Number).sort((a,b)=>a-b).forEach(d=>(data[String(d)].pendientes||[]).forEach(p=>{const k=`${hMes}-${String(d).padStart(2,'0')}`;
    const st=p.ok?'y':past(k)?'n':'';if(past(k)||p.ok){tot.m[1]++;if(p.ok)tot.m[0]++}
    mRows.push({t:`<span class="when" style="margin-right:6px">${d}/${hm}</span>${esc(p.t)}`,raw:1,cells:`<i class="${st}"></i>`,y:p.ok?1:0,e:past(k)||p.ok?1:0,p:null,st})}));
  const sortW=a=>a.sort((x,y)=>(x.p??101)-(y.p??101));
  const row=r=>`<tr><td style="white-space:normal;min-width:170px">${r.raw?r.t:esc(r.t)}</td><td><div class="strip">${r.cells}</div></td><td class="n">${r.e?`${r.y}/${r.e}`:'—'}</td><td class="n">${r.p==null?(r.st==='n'?'<span class="chip bad">No se hizo</span>':r.st==='y'?'<span class="chip acc">Hecha</span>':r.e?'':'<span class="chip">Próxima</span>'):`<span class="pct ${pctCls(r.p)}">${r.p}%</span>`}</td></tr>`;
  const grp=(n,arr)=>arr.length?`<tr class="grp"><td colspan="4">${n}</td></tr>`+arr.map(row).join(''):'';
  const future=hMes>mesHoy;
  $('#histTable').innerHTML=!S.ready?'<tbody><tr><td class="empty">Cargando…</td></tr></tbody>':
    `<thead><tr><th>Tarea</th><th>Día por día</th><th>Hechas</th><th>Cumplimiento</th></tr></thead><tbody>`+grp('Diarias',sortW(dRows))+grp('Semanales',sortW(wRows))+grp('Mensuales',mRows.sort((a,b)=>(a.st==='n'?0:1)-(b.st==='n'?0:1)))+'</tbody>';
  const tile=(k,[y,e])=>{const p=e?Math.round(y/e*100):null;return `<div class="tile"><div class="k">${k}</div><div class="v"><span class="pct ${p==null?'':pctCls(p)}">${p==null?'—':p+'%'}</span></div><div class="h">${e?`${y} de ${e} hechas`:future?'mes futuro':'sin datos todavía'}</div></div>`};
  const worst=dRows.concat(wRows).filter(r=>r.p!=null).sort((a,b)=>a.p-b.p)[0];
  $('#hTiles').innerHTML=tile('Diarias',tot.d)+tile('Semanales',tot.w)+tile('Mensuales',tot.m)+
    `<div class="tile"><div class="k">La que más se saltea</div><div class="v txt" style="font-size:.95rem;color:var(--bad)">${worst&&worst.p<100?(worst.raw?worst.t.replace(/<[^>]+>/g,''):esc(worst.t)):'—'}</div><div class="h">${worst&&worst.p<100?worst.p+'% de cumplimiento':'nada atrasado'}</div></div>`;
}
