  $('#pConv').textContent=pb.length?cv:'—';$('#pTasa').textContent=ms?`${(cv/ms*100).toFixed(1)}% de los mensajes`:'';
  $('#pCpc').textContent=g&&cv?money(g/cv):'—';
  $('#chartPubli').innerHTML=barChart(spMes,[{f:'gasto',c:'var(--s1)',l:'Gasto'}],v=>v>=1000?'$'+Math.round(v/1000)+'k':'$'+Math.round(v));
  $('#pbTable').innerHTML=`<thead><tr><th>Fecha</th><th>Gasto</th><th>Fondeo</th><th>Mensajes</th><th>Conv.</th><th>$/conv.</th><th>Nota</th></tr></thead><tbody>`+
    (pb.length?pb.slice().reverse().map(([k,r])=>`<tr class="click" data-k="${k}"><td>${k.slice(8)}/${k.slice(5,7)}</td><td class="n">${r.gasto!=null?money(r.gasto):''}</td><td class="n">${r.fondeo!=null?money(r.fondeo):''}</td><td class="n">${r.mensajes??''}</td><td class="n">${r.convertidos??''}</td><td class="n">${num(r.gasto)&&num(r.convertidos)?money(r.gasto/r.convertidos):''}</td><td style="white-space:normal;min-width:140px">${esc(r.notaPubli)}</td></tr>`).join(''):`<tr><td colspan="7" class="empty">${S.ready?'Sin publicidad cargada este mes.':'Cargando…'}</td></tr>`)+'</tbody>';
}
