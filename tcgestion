  sp.forEach(([k,r])=>{const s=num(r.bm)+num(r.celus)+num(r.clientes);if(s>0)dias++;else cero++;tot+=s;bm+=num(r.bm);ce+=num(r.celus);cl+=num(r.clientes);if(!best||s>best[1])best=[k,s]});
  $('#sTot').textContent=tot.toLocaleString('es-AR');$('#sTotH').textContent=`BM ${bm} · Celus ${ce} · Clientes ${cl}`;
  $('#sProm').textContent=dias?Math.round(tot/dias):'—';$('#sDias').textContent=`${dias} días con envíos`;
  $('#sMax').textContent=best&&best[1]?best[1]:'—';$('#sMaxH').textContent=best&&best[1]?`el ${best[0].slice(8)}/${best[0].slice(5,7)}`:'';
