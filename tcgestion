<script>
(function(){
const $=s=>document.querySelector(s);
const TZ='America/Argentina/Buenos_Aires';
const today=new Date().toLocaleDateString('en-CA',{timeZone:TZ});
const parse=s=>{const [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)};
const fmt=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const td=parse(today);
const ayer=fmt(new Date(td.getFullYear(),td.getMonth(),td.getDate()-1));
const DIAS=['DOMINGO','LUNES','MARTES','MIERCOLES','JUEVES','VIERNES','SABADO'];
const SEMANA=['LUNES','MARTES','MIERCOLES','JUEVES','VIERNES','SABADO','DOMINGO'];
const MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const diaHoy=DIAS[td.getDay()];
const lunes=new Date(td);lunes.setDate(td.getDate()-((td.getDay()+6)%7));
const weekKey='w-'+fmt(lunes);
const mesHoy=today.slice(0,7);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const num=v=>Number(v)||0;
const money=v=>'$'+Math.round(v).toLocaleString('es-AR');
const addMonth=(mes,n)=>{const [y,m]=mes.split('-').map(Number);const d=new Date(y,m-1+n,1);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`};
const daysIn=mes=>{const [y,m]=mes.split('-').map(Number);return new Date(y,m,0).getDate()};
const mesLabel=mes=>{const [y,m]=mes.split('-').map(Number);return `${MESES[m-1]} ${y}`};
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),1800)}
// borrar en dos toques
function armed(b){if(b.classList.contains('arm'))return true;b.classList.add('arm');const o=b.textContent;b.textContent='¿Borrar?';setTimeout(()=>{b.classList.remove('arm');b.textContent=o},2500);return false}

$('#hoyTxt').textContent=`${diaHoy.charAt(0)+diaHoy.slice(1).toLowerCase()} ${td.getDate()} de ${MESES[td.getMonth()]} de ${td.getFullYear()}`;
$('#dDate').textContent=`${td.getDate()}/${td.getMonth()+1}`;
$('#wDate').textContent=`semana del ${lunes.getDate()}/${lunes.getMonth()+1}`;

const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
function setTab(t){document.querySelectorAll('nav.tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.tab===t));
  document.querySelectorAll('section[role=tabpanel]').forEach(s=>s.hidden=s.id!=='tab-'+t);store.set('tab',t)}
document.querySelectorAll('nav.tabs button').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));
{const t=store.get('tab');if(t&&$('#tab-'+t))setTab(t)}

const S={checks:{},errAll:{},tareas:[],checksDia:{},checksSem:{},diario:{},errores:null,horarios:null,equipo:null,juegos:[],cal:{},ready:false,calReady:false};
let db=null;
let hMes=mesHoy,spMes=mesHoy,cjMes=mesHoy,calMes=mesHoy,mensMes=mesHoy,selDay=null;
let spView=store.get('spView')==='publi'?'publi':'spam', calMode=['contenido','push'].includes(store.get('calMode'))?store.get('calMode'):'juegos';
$('#hMes').value=hMes;$('#spMes').value=spMes;$('#cjMes').value=cjMes;$('#fFecha').value=today;$('#gFecha').value=today;

function need(){if(!db){toast('Sin conexión a los datos');return false}return true}
async function w(p){try{await p}catch(e){toast(e&&e.code==='invalid_argument'?'No tenés permiso para editar':'No se pudo guardar');console.error(e)}}
function cloneMonth(mes){return JSON.parse(JSON.stringify(S.cal[mes]||{}))}
function clean(dias){Object.keys(dias).forEach(k=>{const c=dias[k];if(c.pendientes&&!c.pendientes.length)delete c.pendientes;if(c.contenido&&!c.contenido.length)delete c.contenido;if(c.push&&!c.push.length)delete c.push;if(!Object.keys(c).length)delete dias[k]})}
function saveMonth(mes,dias,msg){clean(dias);S.cal[mes]=dias;renderHoy();renderCal();w(db.doc('calendario/'+mes).set({dias}).then(()=>msg&&toast(msg)))}

/* Segmentos (sub-pestañas) */
function setSeg(name,v){document.querySelectorAll(`.seg[data-seg="${name}"] button`).forEach(b=>b.setAttribute('aria-selected',b.dataset.v===v))}
document.querySelectorAll('.seg[data-seg="sp"] button').forEach(b=>b.onclick=()=>{spView=b.dataset.v;store.set('spView',spView);applySp()});
document.querySelectorAll('.seg[data-seg="cal"] button').forEach(b=>b.onclick=()=>{calMode=b.dataset.v;store.set('calMode',calMode);renderCal()});
function applySp(){setSeg('sp',spView);document.querySelectorAll('#tab-spam [data-view]').forEach(v=>v.hidden=v.dataset.view!==spView);
  $('#spLegend').innerHTML=spView==='spam'?'<span><i style="background:var(--s1)"></i>BM</span><span><i style="background:var(--s2)"></i>Celus</span><span><i style="background:var(--s3)"></i>Clientes</span>':'<span><i style="background:var(--s1)"></i>Gasto</span>'}

/* ---------- HOY ---------- */
// Edición en línea: ED.key = 't:<id>' (tarea) o 'm:<dia>:<i>' (mensual)
const ED={key:null,draft:{}};
const RESP=[{k:'Gen',id:'gen',d:'Tareas de Gen'},{k:'Lean',id:'lean',d:'Tareas de Lean'},{k:'Automatización',id:'auto',d:'Tareas de automatización'},{k:'General',id:'gral',d:'Tareas generales'}];
$('#respGrid').innerHTML=RESP.map(r=>`<div class="card"><h2><span><span class="resp-tag"></span>${r.d}</span><small id="cnt-${r.id}"></small></h2><ul class="list" id="lp-${r.id}"></ul>
  <form class="add" data-tipo="pendiente" data-resp="${r.k}"><input type="text" id="add-${r.id}" placeholder="Nueva tarea"><button class="btn pri">Agregar</button></form></div>`).join('');

function actions(key){return `<button type="button" class="ib" data-edit="${key}" aria-label="Editar" title="Editar">✎</button><button type="button" class="ib del" data-del="${key}" aria-label="Borrar" title="Borrar">×</button>`}
function editRow(key,text,extra){const v=ED.draft.text??text;
  return `<li class="editing" data-key="${key}">${extra||''}<input type="text" class="ed-text" value="${esc(v)}" aria-label="Texto"><button type="button" class="btn pri sm" data-save="${key}">Guardar</button><button type="button" class="btn sm" data-cancel="1">Cancelar</button></li>`}
function taskLi(t,checked,cls){const key='t:'+t.id;
  if(ED.key===key){const extra=t.tipo==='semanal'?`<select class="ed-dia" aria-label="Día">${SEMANA.map(d=>`<option ${d===(ED.draft.dia??t.dia)?'selected':''}>${d}</option>`).join('')}</select>`:'';return editRow(key,t.texto,extra)}
  return `<li class="${checked?'done':''} ${cls||''}" data-key="${key}"><label><input type="checkbox" data-chk="${key}" ${checked?'checked':''}><span class="t">${esc(t.texto)}</span></label>${t.tipo==='semanal'&&t.dia?`<span class="chip ${t.dia===diaHoy?'acc':''}">${esc(t.dia.slice(0,3))}</span>`:''}${actions(key)}</li>`}
function setList(sel,html){const el=$(sel);const a=document.activeElement;if(a&&el.contains(a)&&a.closest('li.editing'))return;el.innerHTML=html}

function renderHoy(){
  const by=t=>S.tareas.filter(x=>x.tipo===t).sort((a,b)=>(a.orden??0)-(b.orden??0));
  const empty=m=>`<li class="empty">${S.ready?m:'Cargando…'}</li>`;
  const di=by('diaria'),se=by('semanal');
  setList('#lDiaria',di.map(t=>taskLi(t,S.checksDia[t.id])).join('')||empty('Sin tareas diarias.'));
  se.sort((a,b)=>SEMANA.indexOf(a.dia)-SEMANA.indexOf(b.dia));
  setList('#lSemanal',se.map(t=>taskLi(t,S.checksSem[t.id],t.dia===diaHoy?'today':'')).join('')||empty('Sin tareas semanales.'));
  // mensuales
  const mm=Number(mensMes.split('-')[1]);$('#mTitle').textContent=mesLabel(mensMes);$('#addMensDia').max=daysIn(mensMes);
  const data=S.cal[mensMes]||{},mens=[];
  Object.keys(data).map(Number).sort((a,b)=>a-b).forEach(d=>(data[String(d)].pendientes||[]).forEach((p,i)=>mens.push({d,i,p})));
  setList('#lMensual',mens.map(({d,i,p})=>{const key=`m:${d}:${i}`,isT=mensMes===mesHoy&&d===td.getDate();
    if(ED.key===key)return editRow(key,p.t,`<input type="number" class="day ed-day" min="1" max="${daysIn(mensMes)}" value="${esc(ED.draft.day??d)}" aria-label="Día">`);
    return `<li class="${p.ok?'done':''} ${isT?'today':''}" data-key="${key}"><span class="when">${d}/${mm}</span><label><input type="checkbox" data-chk="${key}" ${p.ok?'checked':''}><span class="t">${esc(p.t)}</span></label>${actions(key)}</li>`}).join('')||(S.calReady||S.cal[mensMes]?`<li class="empty">Sin tareas este mes. Agregá una con su día.</li>`:'<li class="empty">Cargando…</li>'));
  // pendientes por responsable
  const fh=$('#fHechos').checked;
  RESP.forEach(r=>{const all=by('pendiente').filter(t=>(t.resp||'General')===r.k),pe=all.filter(t=>fh||!t.hecha||ED.key==='t:'+t.id);
    $('#cnt-'+r.id).textContent=`${all.filter(t=>!t.hecha).length} abiertas`;
    setList('#lp-'+r.id,pe.map(t=>taskLi(t,t.hecha)).join('')||empty(fh?'Sin tareas.':'Todo al día.'))});
  // tiles
  const done=di.filter(t=>S.checksDia[t.id]).length;
  $('#kDiarias').textContent=S.ready?`${done}/${di.length}`:'–';
  const mh=[];const dh=S.cal[mesHoy]||{};Object.values(dh).forEach(c=>(c.pendientes||[]).forEach(p=>mh.push(p)));
  const hp=(dh[String(td.getDate())]||{}).pendientes||[];
  $('#kMens').innerHTML=!S.calReady?'<span>–</span>':hp.length?hp.slice(0,3).map(p=>`<span class="${p.ok?'ok':''}" title="${esc(p.t)}">${esc(p.t)}</span>`).join(''):'<span style="color:var(--muted);font-weight:500">Nada para hoy</span>';
  $('#kMensH').textContent=S.calReady?(hp.length>3?`+${hp.length-3} más · `:'')+`${mh.filter(p=>p.ok).length}/${mh.length} del mes hechas`:'\u00a0';
  renderHist();
  const a=S.diario[ayer];$('#kSpamAyer').textContent=a&&(a.bm!=null||a.celus!=null||a.clientes!=null)?num(a.bm)+num(a.celus)+num(a.clientes):'—';
  const c=dh[String(td.getDate())]||{};
  $('#kJuego').textContent=S.calReady?(c.juego||'Sin juego'):'–';$('#kJuegoH').textContent=c.horario||' ';
  if(ED.key){const i=document.querySelector('#tab-hoy li.editing .ed-text');const ae=document.activeElement;if(i&&!(ae&&ae.closest&&ae.closest('li.editing'))){i.focus();i.setSelectionRange(i.value.length,i.value.length)}}
}
$('#fHechos').onchange=renderHoy;
$('#mPrev').onclick=()=>{mensMes=addMonth(mensMes,-1);ED.key=null;subCal(mensMes);renderHoy()};
$('#mNext').onclick=()=>{mensMes=addMonth(mensMes,1);ED.key=null;subCal(mensMes);renderHoy()};

function findTask(key){return S.tareas.find(x=>'t:'+x.id===key)}
function stopEdit(){ED.key=null;ED.draft={};const a=document.activeElement;if(a&&a.blur)a.blur()}
const hoy=$('#tab-hoy');
hoy.addEventListener('change',e=>{
  const key=e.target.dataset.chk;if(!key||!need())return;const v=e.target.checked;
  if(key.startsWith('m:')){const [,d,i]=key.split(':');const dias=cloneMonth(mensMes);const p=dias[d]&&dias[d].pendientes&&dias[d].pendientes[i];if(!p)return;p.ok=v;saveMonth(mensMes,dias);return}
  const t=findTask(key);if(!t)return;
  if(t.tipo==='pendiente'){t.hecha=v;renderHoy();w(db.doc('tareas/'+t.id).update({hecha:v}));return}
  const isW=t.tipo==='semanal',k=isW?weekKey:today,m=Object.assign({},isW?S.checksSem:S.checksDia);if(v)m[t.id]=true;else delete m[t.id];
  if(isW)S.checksSem=m;else S.checksDia=m;S.checks[k]=m;renderHoy();w(db.doc('checks/'+k).set({ids:m}));
});
hoy.addEventListener('input',e=>{const c=e.target.classList;if(c.contains('ed-text'))ED.draft.text=e.target.value;if(c.contains('ed-day'))ED.draft.day=e.target.value});
hoy.addEventListener('change',e=>{if(e.target.classList.contains('ed-dia'))ED.draft.dia=e.target.value});
hoy.addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  if(b.dataset.edit){ED.key=b.dataset.edit;ED.draft={};renderHoy();return}
  if(b.dataset.cancel){stopEdit();renderHoy();return}
  if(b.dataset.save){saveEdit(b.closest('li'));return}
  if(b.dataset.del){if(!need()||!armed(b))return;delItem(b.dataset.del)}
});
hoy.addEventListener('keydown',e=>{const li=e.target.closest&&e.target.closest('li.editing');if(!li)return;
  if(e.key==='Enter'){e.preventDefault();saveEdit(li)}if(e.key==='Escape'){stopEdit();renderHoy()}});
function saveEdit(li){if(!need())return;const key=li.dataset.key,txt=li.querySelector('.ed-text').value.trim();if(!txt){toast('Escribí un texto');return}
  if(key.startsWith('t:')){const t=findTask(key);if(!t){stopEdit();renderHoy();return}const d={texto:txt};const dia=li.querySelector('.ed-dia');if(dia)d.dia=dia.value;Object.assign(t,d);
    stopEdit();renderHoy();w(db.doc('tareas/'+t.id).update(d).then(()=>toast('Tarea actualizada')));return}
  const [,d,i]=key.split(':');const nd=Math.min(daysIn(mensMes),Math.max(1,parseInt(li.querySelector('.ed-day').value,10)||Number(d)));
  const dias=cloneMonth(mensMes);if(!dias[d]||!dias[d].pendientes){stopEdit();renderHoy();return}
  const p=dias[d].pendientes.splice(Number(i),1)[0];p.t=txt;
  const tgt=dias[String(nd)]=dias[String(nd)]||{};tgt.pendientes=(tgt.pendientes||[]).concat(p);stopEdit();saveMonth(mensMes,dias,'Tarea actualizada')}
function delItem(key){
  if(key.startsWith('t:')){const t=findTask(key);if(!t)return;S.tareas=S.tareas.filter(x=>x!==t);renderHoy();w(db.doc('tareas/'+t.id).delete().then(()=>toast('Tarea borrada')));return}
  const [,d,i]=key.split(':');const dias=cloneMonth(mensMes);if(!dias[d]||!dias[d].pendientes)return;dias[d].pendientes.splice(Number(i),1);saveMonth(mensMes,dias,'Tarea borrada')}
document.querySelectorAll('form.add[data-tipo]').forEach(f=>f.addEventListener('submit',e=>{
  e.preventDefault();if(!need())return;const inp=f.querySelector('input[type=text]');const txt=inp.value.trim();if(!txt)return;
  const tipo=f.dataset.tipo,d={texto:txt,tipo,orden:Date.now()};
  if(tipo==='semanal')d.dia=$('#addSemanalDia').value;
  if(tipo==='pendiente'){d.resp=f.dataset.resp||'General';d.hecha=false}
  inp.value='';w(db.collection('tareas').add(d));
}));
$('#addMensForm').onsubmit=e=>{e.preventDefault();if(!need())return;const t=$('#addMens').value.trim();const d=parseInt($('#addMensDia').value,10);
  if(!d||d<1||d>daysIn(mensMes)){toast('Poné el día del mes');$('#addMensDia').focus();return}if(!t){$('#addMens').focus();return}
  const dias=cloneMonth(mensMes);const c=dias[String(d)]=dias[String(d)]||{};c.pendientes=(c.pendientes||[]).concat({t,ok:false});
  $('#addMens').value='';$('#addMensDia').value='';saveMonth(mensMes,dias,'Tarea agregada')};

/* ---------- HISTÓRICO ---------- */
function renderHist(){
  const nd=daysIn(hMes),[hy,hm]=hMes.split('-').map(Number);
  const dates=[];for(let d=1;d<=nd;d++)dates.push(`${hMes}-${String(d).padStart(2,'0')}`);
  const past=k=>k<today; // cuenta hasta ayer
  const pctCls=p=>p<50?'lo':p<80?'mid':'hi';
  const created=t=>(t.orden&&t.orden>1e12)?fmt(new Date(t.orden)):'0000';
  const by=tp=>S.tareas.filter(x=>x.tipo===tp);
  const rows=[];let tot={d:[0,0],w:[0,0],m:[0,0]};
  // diarias
  const dRows=by('diaria').map(t=>{const c=created(t);let y=0,e=0;const cells=dates.map(k=>{if(k<c)return '<i class="x" title="'+k.slice(8)+': no existía"></i>';if(!past(k))return `<i title="${k.slice(8)}/${hm}"></i>`;e++;const ok=(S.checks[k]||{})[t.id];if(ok)y++;return `<i class="${ok?'y':'n'}" title="${k.slice(8)}/${hm}: ${ok?'hecha':'no se hizo'}"></i>`}).join('');
    tot.d[0]+=y;tot.d[1]+=e;return {t:t.texto,cells,y,e,p:e?Math.round(y/e*100):null}});
  // semanales
  const mondays=[];{const f=parse(hMes+'-01');const m0=new Date(f);m0.setDate(f.getDate()-((f.getDay()+6)%7));for(let x=new Date(m0);x<=parse(dates[nd-1]);x.setDate(x.getDate()+7))mondays.push(new Date(x))}
