function barChart(mes,series,fmtV){
  const m=Number(mes.split('-')[1]),nd=daysIn(mes),data=[];
  for(let d=1;d<=nd;d++){const r=S.diario[`${mes}-${String(d).padStart(2,'0')}`]||{};data.push({d,v:series.map(s=>num(r[s.f]))})}
  const max=Math.max(1,...data.map(x=>x.v.reduce((a,b)=>a+b,0)));const step=Math.pow(10,Math.floor(Math.log10(max)));const nice=Math.ceil(max/step)*step;
  const W=Math.max(620,nd*24),H=200,pl=52,pb=20,pt=8,bw=(W-pl-6)/nd,yS=v=>H-pb-(v/nice)*(H-pb-pt);
  let s=`<svg viewBox="0 0 ${W} ${H}" width="100%" style="min-width:${W}px;max-width:100%;display:block" role="img">`;
  for(let i=0;i<=4;i++){const v=nice*i/4,yy=yS(v);s+=`<line x1="${pl}" x2="${W}" y1="${yy}" y2="${yy}" stroke="var(--line)" stroke-width="1"/><text x="${pl-4}" y="${yy+3}" text-anchor="end">${fmtV(v)}</text>`}
  data.forEach((x,i)=>{const cx=pl+i*bw+bw*.15,ww=bw*.7;let base=0;
    x.v.forEach((v,j)=>{if(v>0){const y1=yS(base+v),y0=yS(base);s+=`<rect x="${cx}" y="${y1}" width="${ww}" height="${Math.max(0,y0-y1)}" fill="${series[j].c}" rx="1.5"><title>${x.d}/${m} · ${series[j].l}: ${fmtV(v)}</title></rect>`;base+=v}});
    if(x.d===1||x.d%5===0||x.d===nd)s+=`<text x="${cx+ww/2}" y="${H-6}" text-anchor="middle">${x.d}</text>`});
  return s+'</svg>'}
const SPF=['bm','celus','clientes'],PBF=['gasto','fondeo','mensajes','convertidos'];
const has=(r,fs)=>fs.some(f=>r[f]!=null&&r[f]!=='');
