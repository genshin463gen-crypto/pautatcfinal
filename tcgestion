<style>
/* Layout: consola operativa — pestañas arriba, sub-vistas segmentadas, tiles de resumen y tarjetas por tema */
/* Paleta pedida: gris oscuro de fondo, tarjetas negras, amarillo de acento, texto blanco */
:root{
  --bg:#232427; --surface:#0b0b0c; --surface-2:#2e3034; --line:#3a3c41;
  --fg:#ffffff; --muted:#a7a9ae; --accent:#ffc928; --accent-soft:#3a3214; --on-accent:#0b0b0c;
  --s1:#ffc928; --s2:#ffffff; --s3:#7c7f86;
  --bad:#ff6b5e; --bad-soft:#3a1c1a;
  --display:"Manrope",system-ui,sans-serif; --body:"Manrope",system-ui,sans-serif; --mono:"JetBrains Mono",ui-monospace,monospace;
  --r:10px; color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:14px;line-height:1.45}
.wrap{max-width:1180px;margin:0 auto;padding-inline:16px;padding-block:18px 48px}
header.top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:14px}
h1{font-family:var(--display);font-weight:800;font-size:1.6rem;letter-spacing:-.02em;margin:0;text-wrap:balance}
h1 b{color:var(--accent)}
.sub{color:var(--muted);font-size:.9rem}
.status{font-size:.8rem;color:var(--muted);display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--s3)}
.dot.on{background:var(--accent)}
nav.tabs{display:flex;gap:4px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:18px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:5}
nav.tabs button{font:600 .92rem var(--body);background:none;border:0;border-bottom:3px solid transparent;color:var(--muted);padding:10px 14px;cursor:pointer;white-space:nowrap}
nav.tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.seg{display:inline-flex;background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:3px;margin-bottom:14px;flex-wrap:wrap}
.seg button{font:700 .88rem var(--body);border:0;background:none;color:var(--muted);padding:8px 14px;border-radius:7px;cursor:pointer}
.seg button[aria-selected="true"]{background:var(--accent);color:var(--on-accent)}
