    const l=S.equipo.slice();l[i]={caja:tr.querySelector('.e-caja').value.trim(),nombre:nom,turno:tr.querySelector('.e-turno').value,cbu:tr.querySelector('.e-cbu').value.trim(),sueldo:tr.querySelector('.e-sueldo').value.trim()};eqEdit=null;b.blur();saveEq(l,'Datos actualizados')}});
$('#addEqForm').onsubmit=e=>{e.preventDefault();if(!need())return;const n=$('#eqNom').value.trim();if(!n){$('#eqNom').focus();return}
  const l=(S.equipo||[]).concat({caja:$('#eqCaja').value.trim(),nombre:n,turno:$('#eqTurno').value,cbu:$('#eqCbu').value.trim(),sueldo:$('#eqSueldo').value.trim()});
  ['#eqCaja','#eqNom','#eqCbu','#eqSueldo'].forEach(s=>$(s).value='');saveEq(l,'Persona agregada')};

/* ---------- CALENDARIO (juegos / contenido de redes) ---------- */
function renderCal(){
  setSeg('cal',calMode);document.querySelectorAll('#calForm [data-mode]').forEach(l=>l.hidden=l.dataset.mode!==calMode);
  const [y,m]=calMes.split('-').map(Number);$('#calTitle').textContent=mesLabel(calMes);
  const first=new Date(y,m-1,1),nd=daysIn(calMes),off=(first.getDay()+6)%7,data=S.cal[calMes]||{};
  let h=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(d=>`<div class="dh">${d}</div>`).join('');
  for(let i=0;i<off;i++)h+='<div class="d blank"></div>';
  for(let d=1;d<=nd;d++){const c=data[String(d)]||{};const isT=`${calMes}-${String(d).padStart(2,'0')}`===today;
    const body=calMode==='juegos'?(c.juego?`<span class="g">${esc(c.juego)}</span>`:'')+(c.horario?`<span class="hr">${esc(c.horario)}</span>`:''):calMode==='push'?(c.push||[]).map(x=>`<span class="ps" title="${esc(x)}">${esc(x)}</span>`).join(''):(c.contenido||[]).map(x=>`<span class="ct" title="${esc(x)}">${esc(x)}</span>`).join('');
    const cnt=calMode==='push'&&(c.push||[]).length?`<span class="cnt" title="Push del día">${c.push.length}</span>`:'';
    h+=`<button type="button" class="d ${isT?'today':''} ${selDay===d?'sel':''}" data-d="${d}"><span class="top"><span class="num">${d}</span>${cnt}</span>${body}</button>`}
  $('#cal').innerHTML=h;
  $('#bonoLegend').innerHTML=calMode==='juegos'?S.juegos.map(j=>`<span><b style="color:var(--fg)">${esc(j.nombre)}</b> ${esc(j.bono||'')}</span>`).join(''):'';
  $('#calHint').textContent=calMode==='juegos'?'Juego del día y horario.':calMode==='push'?'Notificaciones push que salen ese día, con su hora.':'Lo que se publica en redes ese día.';
  const sel=$('#cJuego');
  if(!$('#calForm').contains(document.activeElement)){
    sel.innerHTML='<option value="">— sin juego —</option>'+S.juegos.map(j=>`<option>${esc(j.nombre)}</option>`).join('');
    if(selDay){const c=data[String(selDay)]||{};
      if(c.juego&&!S.juegos.some(j=>j.nombre===c.juego))sel.insertAdjacentHTML('beforeend',`<option>${esc(c.juego)}</option>`);
      sel.value=c.juego||'';$('#cHora').value=c.horario||'';$('#cCont').value=(c.contenido||[]).join('\n');$('#cPush').value=(c.push||[]).join('\n')}}
  if(selDay){$('#dayTitle').textContent=`${selDay} de ${MESES[m-1]}`;$('#calForm').hidden=false}
  else{$('#dayTitle').textContent='Elegí un día';$('#calForm').hidden=true}
}
$('#cal').onclick=e=>{const b=e.target.closest('[data-d]');if(!b)return;selDay=Number(b.dataset.d);const a=document.activeElement;if(a&&a.blur)a.blur();renderCal()};
function shiftCal(n){calMes=addMonth(calMes,n);selDay=null;subCal(calMes);renderCal()}
$('#calPrev').onclick=()=>shiftCal(-1);$('#calNext').onclick=()=>shiftCal(1);
$('#calForm').onsubmit=e=>{e.preventDefault();if(!need()||!selDay)return;
  const dias=cloneMonth(calMes);const c=dias[String(selDay)]=dias[String(selDay)]||{};
  if(calMode==='juegos'){const j=$('#cJuego').value,h=$('#cHora').value.trim();if(j)c.juego=j;else delete c.juego;if(h)c.horario=h;else delete c.horario}
  else if(calMode==='push'){c.push=$('#cPush').value.split('\n').map(s=>s.trim()).filter(Boolean)}
  else{c.contenido=$('#cCont').value.split('\n').map(s=>s.trim()).filter(Boolean)}
  const a=document.activeElement;if(a&&a.blur)a.blur();saveMonth(calMes,dias,'Día guardado')};
$('#calClear').onclick=e=>{if(!need()||!selDay||!armed(e.currentTarget))return;const dias=cloneMonth(calMes);const c=dias[String(selDay)]||{};
  if(calMode==='juegos'){delete c.juego;delete c.horario}else if(calMode==='push')delete c.push;else delete c.contenido;dias[String(selDay)]=c;e.currentTarget.blur();saveMonth(calMes,dias,'Día vaciado')};

function renderAll(){renderHoy();applySp();renderSpam();renderCaj();renderCal()}
renderAll();

/* ---------- DATOS ---------- */
let unErr=null;const unCal={};
function err(e){console.error(e);$('#statusTxt').textContent='Error de conexión';$('#dot').classList.remove('on')}
function subErr(){if(!db||unErr)return;unErr=db.collection('errores').onSnapshot(s=>{const o={};s.docs.forEach(d=>o[d.id]=d.data());S.errAll=o;S.errores=o[cjMes]||null;renderCaj()},err)}
function subCal(k){if(!db||unCal[k])return;unCal[k]=db.doc('calendario/'+k).onSnapshot(s=>{S.cal[k]=s.exists?(s.data().dias||{}):{};if(k===mesHoy)S.calReady=true;renderCal();renderHoy()},err)}
$('#cjMes').onchange=()=>{cjMes=$('#cjMes').value||mesHoy;S.errores=S.errAll[cjMes]||null;renderCaj()};

(async()=>{
  const ctx=await window.TC.ready;db=ctx.db;
  if(!db){$('#statusTxt').textContent='Sin conexión con la base de datos';S.ready=S.calReady=true;S.equipo=[];renderAll();return}
  $('#statusTxt').textContent='Datos en vivo';$('#dot').classList.add('on');
  db.collection('tareas').onSnapshot(s=>{S.tareas=s.docs.map(d=>Object.assign({id:d.id},d.data()));S.ready=true;renderHoy()},err);
  db.collection('checks').onSnapshot(s=>{const o={};s.docs.forEach(d=>o[d.id]=Object.assign({},(d.data()||{}).ids));S.checks=o;S.checksDia=Object.assign({},o[today]||{});S.checksSem=Object.assign({},o[weekKey]||{});renderHoy()},err);
  db.collection('diario').onSnapshot(s=>{const o={};s.docs.forEach(d=>o[d.id]=d.data());S.diario=o;renderSpam();renderHoy();
    const a=document.activeElement;if(!a||!a.closest||!a.closest('#spamForm'))fill(SPAM_FORM,'#fFecha',$('#fFecha').value);if(!a||!a.closest||!a.closest('#publiForm'))fill(PUBLI_FORM,'#gFecha',$('#gFecha').value)},err);
  db.doc('config/horarios').onSnapshot(s=>{S.horarios=s.exists?s.data():null;renderCaj()},err);
  db.doc('privado/equipo').onSnapshot(s=>{S.equipo=s.exists?(s.data().lista||[]):[];renderCaj()},err);
  db.doc('config/juegos').onSnapshot(s=>{S.juegos=s.exists?(s.data().lista||[]):[];renderCal()},err);
  subErr();subCal(mesHoy);
})();
})();
